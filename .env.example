# TTB Label Compliance Review Assistant Configuration

# OCR Mode: false = 100% Local Offline (EasyOCR/Tesseract), true = Cloud API Mode
USE_CLOUD_OCR=false

# Confidence & Matching Thresholds
OCR_CONFIDENCE_THRESHOLD=0.80
FUZZY_PASS_THRESHOLD=0.90
FUZZY_REVIEW_THRESHOLD=0.70

# Optional Cloud Vision API Keys (Only used if USE_CLOUD_OCR=true)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_VISION_API_KEY=
